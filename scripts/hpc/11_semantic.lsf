#!/bin/sh
# Semantic uncertainty, aleatoric vs epistemic (scripts/semantic_uncertainty.py):
# every model answers AmbigQA, TriviaQA and NQ-open questions S x N times,
# the answers are clustered by meaning (NLI) and embedded, and the spread is
# split into within-sample (aleatoric) and between-sample (epistemic) parts.
# Then the tables (scripts/semantic_tables.py).
# Budget: ~1 h generation (5 models x 8 samples x 10 answers x 600 questions)
# plus NLI clustering. Submit after the sampling jobs:
#   bsub < scripts/hpc/11_semantic.lsf          (LOSS_ON=response ... too)
#BSUB -J pb_semantic
#BSUB -q gpua100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16GB]"
#BSUB -W 8:00
#BSUB -o logs/%J_semantic.out
#BSUB -e logs/%J_semantic.err

. scripts/hpc/env.sh

out="figures/semantic_uncertainty$SUF.json"
uv run python scripts/semantic_uncertainty.py \
    --samples "$SAMPLES_SEQ" "$SAMPLES_TOK" \
    --adapter "$ADAPTER" \
    --n-questions 200 --n-posterior 8 --n-answers 10 --temperature 0.7 \
    --out "$out"
uv run python scripts/semantic_tables.py --results "$out"
