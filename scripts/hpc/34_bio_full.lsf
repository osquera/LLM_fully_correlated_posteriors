#!/bin/sh
# E31: LoRA vs full fine-tuning. Everything so far restricts theta to LoRA
# adapters (P ~ 2M). Here, on each of E28's three bio corpora: theta_map by
# full fine-tuning (all 135M weights), an 8-member full fine-tuned ensemble,
# and the projected posterior over all weights, with two priors:
#   iso   N(0, alpha^-1 I) on every weight, as for LoRA
#   rms   prior std per tensor proportional to its RMS in theta_map (E31's
#         hypothesis: an isotropic prior over embeddings, norms and matrices
#         is badly scaled, so the measured alpha is set by the most sensitive
#         tensors and the rest barely move)
# Both posteriors at 10 sweeps (E27/E28: = 25 sweeps). Then evaluate_bio.py
# and error_breakdown.py in this "full" world, to compare with E28/E28c's
# LoRA world on the same corpora (each world on its own MAP's errors).
#
# DISK. A full-model checkpoint is 0.27 GB; a posterior file holds two methods
# (projected, isotropic) x 8 samples x 135M in fp16 = 4.3 GB, and both
# posteriors (iso, rms) exist until the evaluation. With
#   - each ensemble member folded into the baselines file (2.2 GB at 8) and
#     its checkpoint deleted before the next member is fine-tuned;
#   - the sample files deleted after the element's evaluation (KEEP=1
#     retains them)
# the peak per element is ~11.3 GB (2 x 4.3 + 2.2 + 2 x 0.27). Three at once
# filled the 30 GB home on 2026-11-01, so the array runs ONE element at a
# time (%1 below; ~30 h in all, each element under the 24 h wall clock).
# STORE moves the checkpoints and samples (not the small figures) to scratch, e.g.
#   bsub -env "STORE=/work3/s214611/llmproj" < scripts/hpc/34_bio_full.lsf
# (a shell-prefix STORE=... does not reach the job: bsub does not forward
# the environment)
#
# WALL. gpuh100 allows at most 24 h, and one element is expected to take
# 8-10 h, so the three are an array (one running at a time, %1) rather than
# one long serial job. With STORE on scratch, drop the %1 to run all three
# at once. Every
# step is skipped when its output already exists (run.json, the .pt files,
# the figures), so a resubmitted element resumes where it stopped, and a
# resubmission is how to continue a run that hits the wall clock.
#
# LR / EPOCHS: full fine-tuning hyperparameters (LoRA used 1e-3 / 20); check
# the MAP accuracy per frequency in the log early (figures/bio_full_eval{s}_map.json).
#   bsub < scripts/hpc/34_bio_full.lsf
#BSUB -J "pb_full[1-3]%1"
#BSUB -q gpuh100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=24GB]"
#BSUB -W 24:00
#BSUB -o logs/%J_%I_full.out
#BSUB -e logs/%J_%I_full.err

. scripts/hpc/env.sh

LR=${LR:-2e-5}
EPOCHS=${EPOCHS:-20}
# Where the big files go. `bsub` does not forward your shell environment, so
# `STORE=/scratch bsub < ...` does NOT reach the job; pass it with -env:
#   bsub -env "STORE=/work3/s214611/llmproj" < scripts/hpc/34_bio_full.lsf
# or edit the default below. Say which one was used, so the log shows where
# the gigabytes went.
STORE=${STORE:-.}
echo "STORE=$STORE (set via bsub -env STORE=... , not a shell prefix)"
mkdir -p "$STORE/checkpoints" "$STORE/samples"

ft() {  # seed, out
    [ -f "$2/run.json" ] || uv run python scripts/finetune_lora.py --full \
        --model HuggingFaceTB/SmolLM2-135M --dataset "$1" --split train \
        --max-length 96 --batch-size 16 --epochs "$EPOCHS" --lr "$LR" \
        --seed "$3" --out "$2"
}

s=$LSB_JOBINDEX
corpus=data/bio_err$s/corpus.json
map=$STORE/checkpoints/bio_full$s
post_iso=$STORE/samples/posterior_bio_full${s}_iso.pt
post_rms=$STORE/samples/posterior_bio_full${s}_rms.pt
baselines=$STORE/samples/baselines_bio_full$s.pt
[ -f "$corpus" ] || { echo "missing $corpus (30_bio_errors.lsf)"; exit 1; }
echo "=================== bio_err$s on $(hostname) ($(date)) ==================="

ft "$corpus" "$map" 0
uv run python scripts/evaluate_bio.py --corpus "$corpus" --adapter "$map" \
    --out figures/bio_full_eval${s}_map.json

sample() {  # prior, out
    [ -f "$2" ] || uv run python scripts/sample_posterior.py \
        --loss-mode token --projector iterative --dataset "$corpus" --split train \
        --n-train 100000 --max-length 96 --proj-batch-size 16 \
        --n-samples 8 --n-iterations 10 --tol 0 --prior-scale "$1" \
        --save-methods projected_measured isotropic_measured --save-dtype float16 \
        --alpha-tol 0.01 --adapter "$map" --out "$2"
}

sample none "$post_iso"
sample rms "$post_rms"

# ensemble: one member on disk at a time. Each is folded into the baselines
# file (--append) as soon as it is trained, marked folded, and its weights
# deleted. (Listing all members on every call, as before, re-read the
# already-deleted ones and failed at member 2.) A resubmitted element skips
# the folded members and continues.
for m in 1 2 3 4 5 6 7 8; do
    mdir=${map}_ens$m
    [ -f "$mdir/folded" ] && continue
    ft "$corpus" "$mdir" "$m"
    uv run python scripts/build_baseline_samples.py --adapter "$map" --append \
        --members "$mdir" --like "$post_iso" --dropconnect-p --save-dtype float16 \
        --out "$baselines" || exit 1
    touch "$mdir/folded"
    rm -f "$mdir"/model.safetensors  # keep run.json (timing)
done

uv run python scripts/evaluate_bio.py --corpus "$corpus" --adapter "$map" \
    --samples "$post_iso" "$post_rms" "$baselines" \
    --methods token/projected_measured token/isotropic_measured \
        token/projected_rms_measured token/isotropic_rms_measured baseline/ensemble \
    --subsets 4 --subset-methods baseline/ensemble \
    --out figures/bio_full_eval$s.json

uv run python scripts/error_breakdown.py --corpus "$corpus" --adapter "$map" \
    --eval figures/bio_full_eval$s.json \
    --scores post="token/projected_measured MI" post_rms="token/projected_rms_measured MI" \
        ens="baseline/ensemble MI" 1-conf="MAP 1-conf" \
    --out figures/error_breakdown_bio_full$s.json

[ "${KEEP:-0}" = 1 ] || rm -f "$post_iso" "$post_rms" "$baselines"
echo "=================== bio_err$s done ($(date)) ==================="
