#!/bin/sh
# E37: E31 again at a learning rate where full fine-tuning works. E35: full
# fine-tuning at lr 1e-4 (20 epochs) answers more probes than LoRA (f = 1
# 0.76 vs 0.67; E31's lr 2e-5: 0.41), so E31 compared LoRA with an
# undertrained full MAP. Same design on E28's three bio corpora: full
# theta_map, 8-member full ensemble, projected posterior over all weights
# (isotropic prior only: E31's RMS prior changed nothing), now with the
# sketched precompute (E36: ~4x cheaper, same samples), 10 sweeps. Then
# evaluate_bio.py, error_breakdown.py and probe_phrasings.py.
#
# DISK. Peak per element: posterior (projected only, fp16) 2.2 GB +
# baselines 2.2 GB + 2 checkpoints 0.5 GB = ~5 GB; one element at a time
# (%1). Free ~6 GB on the home first (e.g. old ~/.vscode-server versions).
# ~1.5 h per element on an H100.
#   bsub < scripts/hpc/37_bio_full_lr.lsf
#BSUB -J "pb_fulllr[1-3]%1"
#BSUB -q gpuh100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=24GB]"
#BSUB -W 8:00
#BSUB -o logs/%J_%I_fulllr.out
#BSUB -e logs/%J_%I_fulllr.err

. scripts/hpc/env.sh

LR=${LR:-1e-4}
EPOCHS=${EPOCHS:-20}
# Where the big files go. `bsub` does not forward your shell environment, so
# `STORE=/scratch bsub < ...` does NOT reach the job; pass it with -env:
#   bsub -env "STORE=/work3/s214611/llmproj" < scripts/hpc/34_bio_full.lsf
# or edit the default below. Say which one was used, so the log shows where
# the gigabytes went.
STORE=${STORE:-.}
echo "STORE=$STORE (set via bsub -env STORE=... , not a shell prefix)"
mkdir -p "$STORE/checkpoints" "$STORE/samples"

ft() {  # seed, out
    [ -f "$2/run.json" ] || uv run python scripts/finetune_lora.py --full \
        --model HuggingFaceTB/SmolLM2-135M --dataset "$1" --split train \
        --max-length 96 --batch-size 16 --epochs "$EPOCHS" --lr "$LR" \
        --seed "$3" --out "$2"
}

s=$LSB_JOBINDEX
corpus=data/bio_err$s/corpus.json
map=$STORE/checkpoints/bio_full${s}_lr$LR
post=$STORE/samples/posterior_bio_full${s}_lr$LR.pt
baselines=$STORE/samples/baselines_bio_full${s}_lr$LR.pt
tag=bio_full${s}_lr$LR
[ -f "$corpus" ] || { echo "missing $corpus (30_bio_errors.lsf)"; exit 1; }
echo "=================== bio_err$s on $(hostname) ($(date)) ==================="

ft "$corpus" "$map" 0
[ -f figures/${tag}_eval_map.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" --adapter "$map" \
    --out figures/${tag}_eval_map.json

[ -f "$post" ] || uv run python scripts/sample_posterior.py \
    --loss-mode token --projector iterative --dataset "$corpus" --split train \
    --n-train 100000 --max-length 96 --proj-batch-size 16 \
    --n-samples 8 --n-iterations 10 --tol 0 --sketch 192 \
    --save-methods projected_measured --save-dtype float16 \
    --alpha-tol 0.01 --adapter "$map" --out "$post"

# ensemble: one member on disk at a time. Each is folded into the baselines
# file (--append) as soon as it is trained, marked folded, and its weights
# deleted. (Listing all members on every call, as before, re-read the
# already-deleted ones and failed at member 2.) A resubmitted element skips
# the folded members and continues.
for m in 1 2 3 4 5 6 7 8; do
    mdir=${map}_ens$m
    [ -f "$mdir/folded" ] && continue
    ft "$corpus" "$mdir" "$m"
    uv run python scripts/build_baseline_samples.py --adapter "$map" --append \
        --members "$mdir" --like "$post" --dropconnect-p --save-dtype float16 \
        --out "$baselines" || exit 1
    touch "$mdir/folded"
    rm -f "$mdir"/model.safetensors  # keep run.json (timing)
done

[ -f figures/${tag}_eval.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
    --adapter "$map" --samples "$post" "$baselines" \
    --methods token/projected_measured baseline/ensemble \
    --subsets 2 4 --subset-methods baseline/ensemble \
    --out figures/${tag}_eval.json

uv run python scripts/error_breakdown.py --corpus "$corpus" --adapter "$map" \
    --eval figures/${tag}_eval.json \
    --scores post="token/projected_measured MI" ens="baseline/ensemble MI" 1-conf="MAP 1-conf" \
    --out figures/error_breakdown_${tag}.json

[ -f figures/phrasings_${tag}.json ] || uv run python scripts/probe_phrasings.py \
    --corpus "$corpus" --adapter "$map" --out figures/phrasings_${tag}.json

[ "${KEEP:-0}" = 1 ] || rm -f "$post" "$baselines"
echo "=================== bio_err$s done ($(date)) ==================="
