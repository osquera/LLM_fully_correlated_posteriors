#!/bin/sh
# E44: TOFU with errors. E42's TOFU fine-tune (20 epochs) answered every
# trained pair, so the error task was empty. Here, as in E40, fewer epochs:
# MAP-only evaluations at 3, 5, 8 and 12 epochs pick the largest epoch count
# whose accuracy on trained pairs is <= 0.85 (bio after 20 epochs: ~0.84).
# Each seen author has 10 trained pairs (E42: 5) + 5 held out, so there
# are 1300 trained probes per replication (~200+ errors at 0.85, bio ~500).
# "Correct" = >= 80% of answer tokens right (--correct-frac 0.8, as E42).
# Then E38's design at that epoch count: timing fine-tune, 8 members, the
# sketched posterior at 5 and 10 sweeps, 2-, 4-, 8-member subsets.
# Question: does the posterior catch TOFU errors (bio: yes, PopQA's
# underfit errors: no, E40)?
# ~2 h per element on an H100.
#   bsub < scripts/hpc/44_tofu_hard.lsf
#BSUB -J "pb_tofuh[1-3]"
#BSUB -q gpuh100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=24GB]"
#BSUB -W 10:00
#BSUB -o logs/%J_%I_tofuh.out
#BSUB -e logs/%J_%I_tofuh.err

. scripts/hpc/env.sh

s=$LSB_JOBINDEX
FRAC=${FRAC:-0.8}
corpus=data/tofuh$s/corpus.json
[ -f "$corpus" ] || uv run python scripts/make_tofu_corpus.py --seed "$s" \
    --n-train 10 --n-heldout 5 --out "$corpus"
ft() {  # epochs, seed, out
    [ -f "$3/run.json" ] || uv run python scripts/finetune_lora.py \
        --model HuggingFaceTB/SmolLM2-135M --dataset "$corpus" --split train \
        --max-length 128 --batch-size 16 --epochs "$1" --lr 1e-3 \
        --lora-targets q_proj v_proj gate_proj up_proj down_proj \
        --seed "$2" --out "$3"
}
seen_acc() {  # map eval json -> accuracy on trained pairs (f >= 1)
    uv run python -c "import json,sys; r=json.load(open(sys.argv[1]))['report']['per_freq']; \
s=[(v['n'],v['map_exact_acc']) for f,v in r.items() if int(f)>=1]; \
print(round(sum(n*a for n,a in s)/sum(n for n,_ in s),3))" "$1"
}

E=""
for ep in 3 5 8 12; do
    a=checkpoints/tofuh${s}_ep${ep}_lora
    ft "$ep" 0 "$a"
    [ -f figures/tofuh${s}_ep${ep}_map.json ] || uv run python scripts/evaluate_bio.py \
        --corpus "$corpus" --adapter "$a" --max-length 128 --correct-frac "$FRAC" \
        --out figures/tofuh${s}_ep${ep}_map.json
    acc=$(seen_acc figures/tofuh${s}_ep${ep}_map.json)
    echo "epochs $ep: seen accuracy $acc"
    awk "BEGIN{exit !($acc <= 0.85)}" && E=$ep
done
[ -n "$E" ] || E=3
echo "=== using $E epochs ==="

adapter=checkpoints/tofuh${s}_ep${E}_lora
samples=samples/posterior_tofuh$s.pt
baselines=samples/baselines_tofuh$s.pt
ft "$E" 99 "${adapter}_timing"  # the cost unit, on this node
members=""
for m in 1 2 3 4 5 6 7 8; do ft "$E" "$m" "${adapter}_ens$m"; members="$members ${adapter}_ens$m"; done

[ -f "$samples" ] || uv run python scripts/sample_posterior.py \
    --loss-mode token --projector iterative --dataset "$corpus" --split train \
    --n-train 100000 --max-length 128 --proj-batch-size 16 \
    --n-samples 8 --n-iterations 10 --snapshots 5 10 --tol 0 --sketch 192 \
    --alpha-tol 0.01 --adapter "$adapter" --out "$samples"

[ -f "$baselines" ] || uv run python scripts/build_baseline_samples.py \
    --adapter "$adapter" --members $members --like "$samples" --dropconnect-p \
    --out "$baselines"

[ -f figures/tofuh_eval$s.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
    --adapter "$adapter" --max-length 128 --correct-frac "$FRAC" \
    --samples "$samples" "$baselines" \
    --methods token/isotropic_measured token/projected_alternating5_measured \
        token/projected_alternating10_measured baseline/lora_ensemble \
    --subsets 2 4 --subset-methods baseline/lora_ensemble \
    --out figures/tofuh_eval$s.json

[ "${KEEP:-0}" = 1 ] || rm -f "$samples" "$baselines"
