#!/bin/sh
# E46: semantic entropy (Farquhar et al. 2024) as a baseline on every
# bio-format task (plan item 10). The standard black-box uncertainty score
# for LLM answers: the MAP samples 10 answers per probe (temperature 1),
# grouped by meaning, entropy of the groups (scripts/semantic_entropy_bio.py).
# Added to the existing evaluations, so bootstrap_bio.py compares it with
# the posterior and the ensembles on the same probes:
#   bio 135M   E38  bio_sketch_eval{s}   exact match, cut at ". "
#   bio 360M   E39  bio360_eval{s}       exact match, cut at ". "
#   PopQA      E40  popqah_eval{s}       exact match (6-epoch MAP)
#   TOFU 20 ep E42  tofu_eval{s}         NLI clusters (answers are sentences)
#   TOFU 3 ep  E44  tofuh_eval{s}        NLI clusters
# One element per replication; ~1-2 h each on an H100 (TOFU's NLI most).
#   bsub < scripts/hpc/46_semantic_entropy.lsf
#BSUB -J "pb_se[1-3]"
#BSUB -q gpuh100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=24GB]"
#BSUB -W 6:00
#BSUB -o logs/%J_%I_se.out
#BSUB -e logs/%J_%I_se.err

. scripts/hpc/env.sh

s=$LSB_JOBINDEX
se() {  # name, corpus, base model, adapter, eval, extra args...
    name=$1; corpus=$2; base=$3; adapter=$4; ev=$5; shift 5
    out=figures/se_${name}_eval$s.json
    if [ -f "$out" ]; then return; fi
    if [ ! -f "$ev" ] || [ ! -d "$adapter" ]; then echo "skip $name: missing $ev or $adapter"; return; fi
    echo "=== $name ==="
    uv run python scripts/semantic_entropy_bio.py --corpus "$corpus" --base-model "$base" \
        --adapter "$adapter" --eval "$ev" --out "$out" "$@"
}
m135=HuggingFaceTB/SmolLM2-135M
m360=HuggingFaceTB/SmolLM2-360M

se bio data/bio_err$s/corpus.json $m135 checkpoints/bio_err${s}_lora \
    figures/bio_sketch_eval$s.json --stop-at-period
se bio360 data/bio_err$s/corpus.json $m360 checkpoints/bio360_err${s}_lora \
    figures/bio360_eval$s.json --stop-at-period
se popqah data/popqa$s/corpus.json $m135 checkpoints/popqah${s}_ep6_lora \
    figures/popqah_eval$s.json
se tofu data/tofu$s/corpus.json $m135 checkpoints/tofu${s}_lora \
    figures/tofu_eval$s.json --cluster nli --max-new-tokens 64
se tofuh data/tofuh$s/corpus.json $m135 checkpoints/tofuh${s}_ep3_lora \
    figures/tofuh_eval$s.json --cluster nli --max-new-tokens 64
