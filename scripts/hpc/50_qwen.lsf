#!/bin/sh
# E50: a second model family. Both core designs on Qwen2.5-0.5B (elements
# 1-6) and Qwen3-0.6B (7-12), LoRA P ~3.9M each (SmolLM2-360M: 3.5M), with
# E49's controls built in:
#   bio (well fit, 20 epochs), corpora 1-3: theta_map, a timing fine-tune,
#     8 members, the sketched posterior at 5 and 10 sweeps, 2/4/8-member
#     subsets, error_breakdown, semantic entropy, membership scores.
#   TOFU (undertrained), corpora 1-3 with 10 trained pairs per author:
#     epochs 1 / 2 / 3 / 5 / 8, the largest with trained accuracy <= 0.85;
#     16 seed members and 16 bagged members (2/4/8/16 groups), the
#     posterior at 5 sweeps, membership scores.
# Smoke-tested on CPU (fine-tune, sketched posterior, alpha) for both.
# The models must be in the HF cache first (download on a login node).
# ~5-8 h per element on an H100.
#   bsub < scripts/hpc/50_qwen.lsf
#BSUB -J "pb_qwen[1-12]"
#BSUB -q gpuh100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=48GB]"
#BSUB -W 24:00
#BSUB -o logs/%J_%I_qwen.out
#BSUB -e logs/%J_%I_qwen.err

. scripts/hpc/env.sh

FRAC=${FRAC:-0.8}
i=$LSB_JOBINDEX
if [ "$i" -le 6 ]; then MODEL=Qwen/Qwen2.5-0.5B; Q=qw25; j=$i; else MODEL=Qwen/Qwen3-0.6B; Q=qw3; j=$((i - 6)); fi
POST="--sketch 192 --max-sketch-gb 40 --row-batch 8"
LORA="--lora-targets q_proj v_proj gate_proj up_proj down_proj"
echo "=== $MODEL, element $j ==="

if [ "$j" -le 3 ]; then
    # ---------------- bio, well fit ----------------
    s=$j
    corpus=data/bio_err$s/corpus.json
    adapter=checkpoints/bio_${Q}_err${s}_lora
    samples=samples/posterior_bio_${Q}_$s.pt
    baselines=samples/baselines_bio_${Q}_$s.pt
    tag=bio_${Q}_eval$s
    ft() { [ -f "$2/run.json" ] || uv run python scripts/finetune_lora.py --model "$MODEL" \
        --dataset "$corpus" --split train --max-length 96 --batch-size 16 --epochs 20 --lr 1e-3 \
        $LORA --seed "$1" --out "$2"; }
    [ -f "$corpus" ] || { echo "missing $corpus"; exit 1; }
    ft 0 "$adapter"
    [ -f figures/${tag}_map.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
        --base-model "$MODEL" --adapter "$adapter" --out figures/${tag}_map.json
    ft 99 "${adapter}_timing"
    members=""
    for m in 1 2 3 4 5 6 7 8; do ft "$m" "${adapter}_ens$m"; members="$members ${adapter}_ens$m"; done
    [ -f "$samples" ] || uv run python scripts/sample_posterior.py --base-model "$MODEL" \
        --loss-mode token --projector iterative --dataset "$corpus" --split train \
        --n-train 100000 --max-length 96 --proj-batch-size 16 \
        --n-samples 8 --n-iterations 10 --snapshots 5 10 --tol 0 $POST \
        --alpha-tol 0.01 --adapter "$adapter" --out "$samples"
    [ -f "$baselines" ] || uv run python scripts/build_baseline_samples.py --base-model "$MODEL" \
        --adapter "$adapter" --members $members --like "$samples" --dropconnect-p --out "$baselines"
    [ -f figures/$tag.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
        --base-model "$MODEL" --adapter "$adapter" --samples "$samples" "$baselines" \
        --methods token/isotropic_measured token/projected_alternating5_measured \
            token/projected_alternating10_measured baseline/lora_ensemble \
        --subsets 2 4 --subset-methods baseline/lora_ensemble --out figures/$tag.json
    uv run python scripts/error_breakdown.py --corpus "$corpus" --base-model "$MODEL" \
        --adapter "$adapter" --eval figures/$tag.json \
        --scores post="token/projected_alternating5_measured MI" ens8="baseline/lora_ensemble MI" \
            1-conf="MAP 1-conf" --out figures/error_breakdown_bio_${Q}_$s.json
    [ -f figures/se_$tag.json ] || uv run python scripts/semantic_entropy_bio.py \
        --corpus "$corpus" --base-model "$MODEL" --adapter "$adapter" \
        --eval figures/$tag.json --stop-at-period --out figures/se_$tag.json
    [ -f figures/e49_bio_${Q}_$s.json ] || uv run python scripts/membership_scores.py \
        --corpus "$corpus" --base-model "$MODEL" --adapter "$adapter" \
        --eval figures/se_$tag.json --out figures/e49_bio_${Q}_$s.json
else
    # ---------------- TOFU, undertrained ----------------
    s=$((j - 3))
    corpus=data/tofuh$s/corpus.json
    [ -f "$corpus" ] || uv run python scripts/make_tofu_corpus.py --seed "$s" \
        --n-train 10 --n-heldout 5 --out "$corpus"
    ft() {  # epochs, seed, out, extra...
        e=$1; sd=$2; o=$3; shift 3
        [ -f "$o/run.json" ] || uv run python scripts/finetune_lora.py --model "$MODEL" \
            --dataset "$corpus" --split train --max-length 128 --batch-size 16 --epochs "$e" \
            --lr 1e-3 $LORA --seed "$sd" --out "$o" "$@"
    }
    seen_acc() {
        uv run python -c "import json,sys; r=json.load(open(sys.argv[1]))['report']['per_freq']; \
s=[(v['n'],v['map_exact_acc']) for f,v in r.items() if int(f)>=1]; \
print(round(sum(n*a for n,a in s)/sum(n for n,_ in s),3))" "$1"
    }
    E=""
    for ep in 1 2 3 5 8; do
        a=checkpoints/tofuh_${Q}_${s}_ep${ep}_lora
        ft "$ep" 0 "$a"
        m=figures/tofuh_${Q}_${s}_ep${ep}_map.json
        [ -f "$m" ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
            --base-model "$MODEL" --adapter "$a" --max-length 128 --correct-frac "$FRAC" --out "$m"
        acc=$(seen_acc "$m")
        echo "epochs $ep: seen accuracy $acc"
        awk "BEGIN{exit !($acc <= 0.85)}" && E=$ep
    done
    [ -n "$E" ] || E=1
    echo "=== using $E epochs ==="
    adapter=checkpoints/tofuh_${Q}_${s}_ep${E}_lora
    samples=samples/posterior_tofuh_${Q}_$s.pt
    baselines=samples/baselines_tofuh_${Q}_$s.pt
    bagged=samples/bagged_tofuh_${Q}_$s.pt
    tag=tofuh_${Q}_eval$s
    ft "$E" 99 "${adapter}_timing"
    members=""; bags=""
    for m in $(seq 1 16); do
        ft "$E" "$m" "${adapter}_ens$m"; members="$members ${adapter}_ens$m"
        ft "$E" $((100 + m)) "${adapter}_bag$m" --bootstrap-seed "$m"; bags="$bags ${adapter}_bag$m"
    done
    [ -f "$samples" ] || uv run python scripts/sample_posterior.py --base-model "$MODEL" \
        --loss-mode token --projector iterative --dataset "$corpus" --split train \
        --n-train 100000 --max-length 128 --proj-batch-size 16 \
        --n-samples 8 --n-iterations 5 --tol 0 $POST \
        --alpha-tol 0.01 --adapter "$adapter" --out "$samples"
    [ -f "$baselines" ] || uv run python scripts/build_baseline_samples.py --base-model "$MODEL" \
        --adapter "$adapter" --members $members --like "$samples" --dropconnect-p --out "$baselines"
    [ -f "$bagged" ] || uv run python scripts/build_baseline_samples.py --base-model "$MODEL" \
        --adapter "$adapter" --members $bags --like "$samples" --dropconnect-p \
        --name bagged_ensemble --out "$bagged"
    [ -f figures/$tag.json ] || uv run python scripts/evaluate_bio.py --corpus "$corpus" \
        --base-model "$MODEL" --adapter "$adapter" --max-length 128 --correct-frac "$FRAC" \
        --samples "$samples" "$baselines" "$bagged" \
        --methods token/isotropic_measured token/projected_measured \
            baseline/lora_ensemble baseline/bagged_ensemble \
        --subsets 2 4 8 --subset-methods baseline/lora_ensemble baseline/bagged_ensemble \
        --out figures/$tag.json
    [ -f figures/e49_$tag.json ] || uv run python scripts/membership_scores.py \
        --corpus "$corpus" --base-model "$MODEL" --adapter "$adapter" \
        --eval figures/$tag.json --out figures/e49_$tag.json
    rm -f "$bagged"
fi

[ "${KEEP:-0}" = 1 ] || rm -f "$samples" "$baselines"
